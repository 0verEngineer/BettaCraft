{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://github.com/0verEngineer/BettaCraft",
    "sources": "https://github.com/0verEngineer/BettaCraft",
    "issues": "https://github.com/0verEngineer/BettaCraft/issues"
  },
  "license": "${mod_license}",
  "icon": "bettacraft.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.overengineer.bettacraft.fabric.BettaCraftFabric"
    ],
    "client": [
      "org.overengineer.bettacraft.fabric.client.BettaCraftFabricClient"
    ],
    "jade": [
      "org.overengineer.bettacraft.compat.jade.BettaCraftJadePlugin"
    ],
    "jei_mod_plugin": [
      "org.overengineer.bettacraft.compat.jei.BettaCraftJeiPlugin"
    ],
    "rei_client": [
      "org.overengineer.bettacraft.fabric.compat.BettaCraftReiPlugin"
    ],
    "theoneprobe": [
      "org.overengineer.bettacraft.fabric.compat.TopFabricPlugin"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "forgeconfigapiport": ">=21.11.0"
  },
  "suggests": {
    "modonomicon": "*",
    "modmenu": "*",
    "jade": "*",
    "jei": "*",
    "wthit": "*",
    "roughlyenoughitems": "*"
  }
}
