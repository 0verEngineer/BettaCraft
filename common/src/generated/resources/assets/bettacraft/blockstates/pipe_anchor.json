{
  "multipart": [
    {
      "apply": {
        "model": "bettacraft:block/pipe_anchor"
      },
      "when": {
        "mount": "down"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/pipe_anchor",
        "x": 180
      },
      "when": {
        "mount": "up"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/pipe_anchor",
        "x": 270
      },
      "when": {
        "mount": "north"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/pipe_anchor",
        "x": 270,
        "y": 180
      },
      "when": {
        "mount": "south"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/pipe_anchor",
        "x": 270,
        "y": 270
      },
      "when": {
        "mount": "west"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/pipe_anchor",
        "x": 270,
        "y": 90
      },
      "when": {
        "mount": "east"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/plumbing_arm",
        "x": 90
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/plumbing_arm",
        "x": 270
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/plumbing_arm"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/plumbing_arm",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/plumbing_arm",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "bettacraft:block/plumbing_arm",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    }
  ]
}